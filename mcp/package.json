{
  "name": "@devdigest/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevDigest local stdio MCP server — thin client over the Fastify API on :3001. Exposes list_agents, run_agent_on_pr, get_findings, get_conventions, get_blast_radius (stub) so an MCP-capable agent can drive DevDigest reviews without the UI.",
  "scripts": {
    "start": "node bin/devdigest-mcp.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inspect": "npx @modelcontextprotocol/inspector node bin/devdigest-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "^3.25.76",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
