node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
# the whole tree, not just cache/ — .devdigest/review/last-report.json must
# stay untracked too, or writing it would change the fingerprint it just
# recorded (see .claude/skills/pr-self-review/reference/report-format.md)
.devdigest/
clones/

# pnpm 10+ ERR_PNPM_IGNORED_BUILDS stub — see root INSIGHTS.md (2026-09-17).
# Regenerated on every fresh install; never meant to be committed.
pnpm-workspace.yaml
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# Claude Code plan-mode scratch files — session-local, not durable docs
plans/
